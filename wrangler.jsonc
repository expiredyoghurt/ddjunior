{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dialogue-dash-junior",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // The game (public/) is served as static files. Only /api/* runs the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // 1) npx wrangler d1 create dialogue-dash-junior   2) paste the database_id it prints below.
  // 3) npx wrangler d1 migrations apply dialogue-dash-junior --remote
  "d1_databases": [
    { "binding": "DB", "database_name": "dialogue-dash-junior", "database_id": "5a00e15a-cc56-45e6-a481-9e24b58990d9", "migrations_dir": "migrations" }
  ],

  // Slows down guessing of class codes and passwords (per IP). Remove if you prefer a WAF rule.
  "ratelimits": [
    { "name": "RL_LOGIN", "namespace_id": "4201", "simple": { "limit": 20, "period": 60 } }
  ],

  // Set these with `npx wrangler secret put <NAME>` before class use:
  //   teacher_user, teacher_password   the admin sign-in (required)
  //   session_secret                   optional random string used to sign sign-in tokens
  "secrets": { "required": ["teacher_user", "teacher_password"] }
}
